#create program to output names based on the .ending of a 'file'

def main():
  def file(file_name):
    if file_name.endswith(".gif"):
      return("image/gif")
    else:
      return("application/octet-stream")


  file_name = input("File name: ")
  cleaned_file_name = file_name.strip().lower()
  result = file(cleaned_file_name)
  print(result)

main()
