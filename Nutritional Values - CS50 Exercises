#make a file that gives calories of fruits that are input by the user

def main():

    fruits = [
    ("Apple", 30),
    ("Avocado", 50),
    ("Banana", 110),
    ("Grapefruit", 60),
    ("Grapes", 90),
    ("Pear", 60)
]

    user_input = (input("Please enter a fruit: ")).lower()

    for fruit, calories in fruits:
        if user_input == fruit.lower():
            print(f"Fruit: {fruit}, Calories: {calories}")
            break
    else:
        print("Please enter a different fruit.")

if __name__ == "__main__":
    main()
