#Ask for greeting, hello output $0, h start but not hello output $20, else output $100

def main():
  def money(greeting):
    if greeting == "Hello":
      return("$0")
    elif greeting.startswith("h"):
      return("$20")
    else:
      return("$100")

  greeting = input("Greeting: ")
  cleaned_greeting = greeting.strip().lower()
  result = money(cleaned_greeting)
  print(result)


main()

