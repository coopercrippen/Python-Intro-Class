#Conditionals Class
#For example: >, >=, <, <=, ==, !=
##################################


#comparison
x = int(input("What's x? "))
y = int(input("What's y? "))

if x < y:
  print("x is less than y")
if x > y:
  print("x is greater than y")
if x == y:
  print("x is equal to y")

##################################
#improving the efficiency
x = int(input("What's x? "))
y = int(input("What's y? "))

if x < y:
  print("x is less than y")
elif x > y:
  print("x is greater than y")
elif x == y:
  print("x is equal to y")

##################################
#improving the efficiency even more
#down to 2 questions from 3
x = int(input("What's x? "))
y = int(input("What's y? "))

if x < y:
  print("x is less than y")
elif x > y:
  print("x is greater than y")
else:
  print("x is equal to y")


##################################
#using or 

x = int(input("What's x? "))
y = int(input("What's y? "))

if x < y or x > y:
  print("x is not equal to y")
else:
  print("x is equal to y")


##################################
#making it simpler with same result

x = int(input("What's x? "))
y = int(input("What's y? "))

if x != y
  print("x is not equal to y")
else:
  print("x is equal to y")


