##################################

def main()
x = int(input("What's x? ")
  if is_even(x):
    print("Even")
  else:
    print("Odd")

def is_even(n):
  if n % 2 == 0
    return True
  else:
    return False


main()


##################################
#making the same code more condensed as we have been
def main()
x = int(input("What's x? ")
  if is_even(x):
    print("Even")
  else:
    print("Odd")

def is_even(n):
  return True if n % 2 == 0 else False


