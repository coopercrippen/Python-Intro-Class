#Guessing game 
import random


def main():
    return rando()

def rando():
    random_number = random.randint(1, 10)
    print("You have to guess a number between 1 and 10.")
    print("I will let you know if it is right or wrong.")
    guess = int(input("What number would you like to guess? "))
    if guess == random_number:
        print("Goodjob you got it right!")
    else:
        print(input("That's not right, try again. What is your guess? "))
        return rando()

main()
