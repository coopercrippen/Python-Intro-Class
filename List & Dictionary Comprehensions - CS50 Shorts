#breaks down text into each word and gives the number of times it appears

def main():
  counts = {}
  words = get_words("address.txt")
  lowercase_words = [word.lower() for word in words if len(word) > 4]

  for words in lowercase_words:
    if word in counts:
      counts[word] += 1
    else:
      counts[words] = 1

  save_counts(counts)


