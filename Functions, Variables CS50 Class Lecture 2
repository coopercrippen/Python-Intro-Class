#making it function better

def hello(to):
  print("hello,", to)

name = input("What is your name? ")
hello(name)

##################################
#cleaner way to use functions & not order things in the way that you want
def main():
    name = input("What is your name? ")
    hello(name)

def hello(to="world"):
    print("hello,", to)

main()

